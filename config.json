{
  "port": 7460,
  "data": "data",
  "keepRuns": 200,
  "keepArtifacts": 10,
  "stepTimeoutSec": 1800,
  "tmpRoot": "/tmp/oci",
  "env": {
    "PATH": "/Users/macmini/.nvm/versions/node/v26.13.0/bin:/Users/macmini/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Applications/Docker.app/Contents/Resources/bin",
    "DOCKER_HOST": "unix:///Users/macmini/.docker/run/docker.sock",
    "TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE": "/var/run/docker.sock",
    "CARGO_TERM_COLOR": "never",
    "FORCE_COLOR": "0"
  },
  "tracker": {
    "url": "http://127.0.0.1:7700",
    "tokenFile": "~/.config/opsbuf-issues/token"
  },
  "apiTokenFile": "~/.config/opsbuf-issues/token",
  "projects": [
    {
      "id": "opsbuf-app",
      "name": "opsbuf app",
      "repo": "/Users/macmini/Apps/opsbuf-ci/repos/opsbuf-app.git",
      "defaultBranch": "main",
      "mirror": "git@github.com:pawelpolakk2/opsbuf-app.git",
      "autoMerge": false,
      "steps": [
        {
          "name": "Install",
          "run": "pnpm install --frozen-lockfile",
          "stopOnFailure": true
        },
        {
          "name": "Rust tests",
          "run": "cargo test --workspace --no-fail-fast",
          "report": {
            "type": "cargo",
            "title": "Rust"
          }
        },
        {
          "name": "UI tests",
          "run": "pnpm --filter opsbuf-ui test --reporters=default --reporters=junit --output-file=\"$CI_REPORTS/ui-tests.xml\"",
          "report": {
            "type": "junit",
            "file": "ui-tests.xml",
            "title": "UI"
          }
        },
        {
          "name": "Build",
          "run": "pnpm build"
        }
      ],
      "release": [
        {
          "name": "Package",
          "run": "bash scripts/ci-package.sh"
        },
        {
          "name": "Testing app",
          "run": "bash apps/testing/scripts/release.sh"
        }
      ],
      "jobs": {
        "e2e": {
          "name": "End-to-end",
          "run": "bash apps/testing/scripts/e2e.sh",
          "params": [
            "tests"
          ],
          "prepare": [
            {
              "name": "dev-env manifests",
              "inputs": [
                "dev-env"
              ],
              "run": "bash dev-env/apply.sh"
            },
            {
              "name": "dev-env seed",
            "inputs": [
              "dev-env/seed",
              "dev-env/data",
              "dev-env/k8s/infra.yaml",
              "dev-env/kustomization.yaml",
              "dev-env/seed.sh"
            ],
            "run": "bash dev-env/seed.sh"
            },
            {
              "name": "dev-env redis seed",
              "inputs": [
                "dev-env/redis"
              ],
              "run": "bash dev-env/redis-seed.sh"
            }
          ],
          "report": {
            "type": "junit",
            "file": "e2e.xml",
            "title": "End-to-end"
          },
          "every": "1h"
        }
      }
    },
    {
      "id": "opsbuf-web",
      "name": "opsbuf web",
      "repo": "/Users/macmini/Apps/opsbuf-ci/repos/opsbuf-web.git",
      "defaultBranch": "main",
      "keep": [
        ".gradle",
        "build"
      ],
      "env": {
        "JAVA_HOME": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home"
      },
      "steps": [
        {
          "name": "Install",
          "run": "cd frontend && pnpm install --frozen-lockfile",
          "stopOnFailure": true
        },
        {
          "name": "Backend tests",
          "run": "cd backend && ./gradlew test --no-daemon --console=plain",
          "report": {
            "type": "junit",
            "dir": "backend/build/test-results/test",
            "title": "Backend"
          }
        },
        {
          "name": "Frontend tests",
          "run": "cd frontend && pnpm exec ng test --watch=false --reporters=default --reporters=junit --output-file=\"$CI_REPORTS/frontend-tests.xml\"",
          "report": {
            "type": "junit",
            "file": "frontend-tests.xml",
            "title": "Frontend"
          }
        },
        {
          "name": "Frontend build",
          "run": "cd frontend && pnpm build"
        },
        {
          "name": "Backend build",
          "run": "cd backend && ./gradlew installDist --no-daemon --console=plain"
        }
      ],
      "release": [
        {
          "name": "Release",
          "run": "bash deploy/release.sh"
        }
      ]
    },
    {
      "id": "opsbuf-issues",
      "name": "opsbuf issues",
      "repo": "/Users/macmini/Apps/opsbuf-ci/repos/opsbuf-issues.git",
      "defaultBranch": "main",
      "mirror": "git@github.com:pawelpolakk2/opsbuf-issues.git",
      "autoMerge": false,
      "steps": [
        {
          "name": "Install",
          "run": "cd web && pnpm install --frozen-lockfile",
          "stopOnFailure": true
        },
        {
          "name": "Rust tests",
          "run": "cargo test --no-fail-fast",
          "report": {
            "type": "cargo",
            "title": "Rust"
          }
        },
        {
          "name": "Web tests",
          "run": "cd web && pnpm exec ng test --watch=false --reporters=default --reporters=junit --output-file=\"$CI_REPORTS/web-tests.xml\"",
          "report": {
            "type": "junit",
            "file": "web-tests.xml",
            "title": "Web"
          }
        },
        {
          "name": "Web build",
          "run": "cd web && pnpm build"
        },
        {
          "name": "Release build",
          "run": "cargo build --release"
        }
      ],
      "release": [
        {
          "name": "Release",
          "run": "bash scripts/release.sh"
        }
      ]
    },
    {
      "id": "elektryka",
      "name": "elektryka",
      "repo": "/Users/macmini/Apps/opsbuf-ci/repos/elektryka.git",
      "defaultBranch": "main",
      "steps": [
        {
          "name": "Install",
          "run": "npm ci --no-audit --no-fund",
          "stopOnFailure": true
        },
        {
          "name": "Tests",
          "run": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=\"$CI_REPORTS/tests.xml\" \"test/*.test.ts\"",
          "report": {
            "type": "junit",
            "file": "tests.xml",
            "title": "elektryka"
          }
        },
        {
          "name": "Build",
          "run": "npm run build"
        }
      ],
      "release": [
        {
          "name": "Release",
          "run": "bash scripts/release.sh"
        }
      ]
    },
    {
      "id": "instalacje",
      "name": "instalacje",
      "repo": "/Users/macmini/Apps/opsbuf-ci/repos/instalacje.git",
      "defaultBranch": "main",
      "steps": [
        {
          "name": "Install",
          "run": "npm ci --no-audit --no-fund",
          "stopOnFailure": true
        },
        {
          "name": "Tests",
          "run": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=\"$CI_REPORTS/tests.xml\" \"test/*.test.ts\"",
          "report": {
            "type": "junit",
            "file": "tests.xml",
            "title": "instalacje"
          }
        },
        {
          "name": "Build",
          "run": "npm run build"
        }
      ],
      "release": [
        {
          "name": "Release",
          "run": "bash scripts/release.sh"
        }
      ]
    },
    {
      "id": "opsbuf-testlab",
      "name": "test lab",
      "repo": "/Users/macmini/Apps/opsbuf-ci/repos/opsbuf-testlab.git",
      "defaultBranch": "main",
      "mirror": "git@github.com:pawelpolakk2/opsbuf-testlab.git",
      "autoMerge": false,
      "keep": [
        "services/java/.gradle"
      ],
      "env": {
        "JAVA_HOME": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home"
      },
      "steps": [
        {
          "name": "Infra tests",
          "run": "bash deploy/test.sh"
        },
        {
          "name": "Node build",
          "run": "cd frontends && npm ci --no-audit --no-fund && npm run build && npx tsc -p ../services/node/tsconfig.json"
        },
        {
          "name": "Node tests",
          "run": "mkdir -p ~/.cache/opsbuf-agents && lockf -k -t 900 ~/.cache/opsbuf-agents/container-tests.lock timeout 900 node --test --test-timeout=600000 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=\"$CI_REPORTS/node-tests.xml\" 'libs/node/test/*.test.ts' 'services/node/test/*.test.ts'",
          "report": {
            "type": "junit",
            "file": "node-tests.xml",
            "title": "Node"
          }
        },
        {
          "name": "Control build",
          "run": "cd control && pnpm install --frozen-lockfile --ignore-workspace && pnpm build"
        },
        {
          "name": "Control tests",
          "run": "mkdir -p ~/.cache/opsbuf-agents && cd control && TESTLAB_TEST_CONTEXT=docker-desktop lockf -k -t 900 ~/.cache/opsbuf-agents/container-tests.lock timeout 900 node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=\"$CI_REPORTS/control-tests.xml\" server/*.test.ts",
          "report": {
            "type": "junit",
            "file": "control-tests.xml",
            "title": "Control"
          }
        },
        {
          "name": "Crowd build",
          "run": "cd traffic/crowd && pnpm install --frozen-lockfile --ignore-workspace && npx tsc -p ."
        },
        {
          "name": "Crowd tests",
          "run": "cd traffic/crowd && TESTLAB_TEST_CONTEXT=docker-desktop timeout 300 node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=\"$CI_REPORTS/crowd-tests.xml\" test/*.test.ts",
          "report": {
            "type": "junit",
            "file": "crowd-tests.xml",
            "title": "Crowd"
          }
        },
        {
          "name": "Java tests",
          "run": "bash services/java/test.sh"
        },
        {
          "name": "Python tests",
          "run": "bash services/python/test.sh"
        },
        {
          "name": "Rust tests",
          "run": "bash services/rust/payments-gw/test.sh",
          "report": {
            "type": "cargo",
            "title": "Rust"
          }
        }
      ]
    },
    {
      "id": "opsbuf-ci",
      "name": "CI",
      "repo": "/Users/macmini/Apps/opsbuf-ci/repos/opsbuf-ci.git",
      "defaultBranch": "main",
      "mirror": "git@github.com:pawelpolakk2/opsbuf-ci.git",
      "autoMerge": false,
      "steps": [
        {
          "name": "Tests",
          "run": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=\"$CI_REPORTS/tests.xml\" test/*.test.mjs",
          "report": {
            "type": "junit",
            "file": "tests.xml",
            "title": "CI"
          }
        },
        {
          "name": "Syntax",
          "run": "for f in server.mjs lib/*.mjs public/app.js scripts/*.sh; do case $f in *.sh) bash -n $f;; *) node --check $f;; esac || exit 1; done && echo all files parse"
        }
      ],
      "release": [
        {
          "name": "Release",
          "run": "bash scripts/release.sh"
        }
      ]
    }
  ]
}
